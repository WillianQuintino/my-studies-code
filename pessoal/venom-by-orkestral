venom
  .create(
    //sessão
    'sessionName', //Passe o nome do cliente para iniciar o bot
    //catchQR
    (base64Qrimg, asciiQR, attempts, urlCode) => {
      console.log('Número de tentativas para ler o QR code: ', attempts);
      console.log('QR code no terminal: ', asciiQR);
      console.log('QR code como string de imagem em base64: ', base64Qrimg);
      console.log('urlCode (data-ref): ', urlCode);
    },
    // statusFind
    (statusSession, session) => {
      console.log('Status da Sessão: ', statusSession); //Returna isLogged || notLogged || browserClose || qrReadSuccess || qrReadFail || autocloseCalled || desconnectedMobile || deleteToken || chatsAvailable || deviceNotConnected || serverWssNotConnected || noOpenBrowser || initBrowser || openBrowser || connectBrowserWs || initWhatsapp || erroPageWhatsapp || successPageWhatsapp || waitForLogin || waitChat || successChat
      //Criar sessão via WSS retorna `"serverClose"` caso o servidor seja encerrado
      console.log('Nome da sessão: ', session);
    },
    // opções
    {
      browserPathExecutable: '', // Caminho executável do navegador
      folderNameToken: 'tokens', //Diretório da pasta de tokens, apenas dentro da pasta do Venom, Exemplo:  { mkdirFolderToken: '/node_modules', } //irá salvar a pasta de tokens dentro do diretório `node_modules`
      headless: 'new', // você não deve mais usar os valores booleanos false ou true; agora deve usar false, true ou 'new' saiba mais em: https://developer.chrome.com/articles/new-headless/
      devtools: false, // Abrir o DevTools por padrão
      debug: false, // Abre uma sessão de depuração
      logQR: true, // Exibe automaticamente o QR code no terminal
      browserWS: '', // Se você quiser usar browserWSEndpoint
      browserArgs: [''], // Parâmetros originais ---Parâmetros a serem adicionados na instância do navegador Chrome
      addBrowserArgs: [''], // Adicione broserArgs sem sobrescrever os parâmetros originais do projeto
      puppeteerOptions: {}, // Será passado para puppeteer.launch
      disableSpins: true, // Desativará a animação do Spinnies, útil para containers (como Docker), proporcionando logs mais limpos
      disableWelcome: true, // Desativará a mensagem de boas-vindas que aparece no início
      updatesLog: true, // Exibe automaticamente no terminal os logs de informações e atualizações
      autoClose: 60000, // Fecha automaticamente o venom-bot apenas durante a leitura do QR code (padrão: 60 segundos; se quiser desativar, defina como `0` ou `false`)
      createPathFileToken: false, // Cria uma pasta ao inserir um objeto no navegador do cliente; para funcionar, é necessário passar os parâmetros na função `create` usando `browserSessionToken`
      addProxy: [''], // Adiciona servidor proxy exemplo: [e1.p.webshare.io:01, e1.p.webshare.io:01]
      userProxy: '', // Proxy login username
